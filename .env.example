# .env.local is written by `npm run convex` on first run. Never commit it.
#
# CONVEX_DEPLOYMENT=dev:<deployment-name>
# NEXT_PUBLIC_CONVEX_URL=https://<deployment-name>.convex.cloud
# NEXT_PUBLIC_CONVEX_SITE_URL=https://<deployment-name>.convex.site
#
# No OpenAI key here: users enter their own key in the app's Settings,
# and it stays in their browser.
