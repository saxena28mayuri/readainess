      "html": "<nav class=\"ds-rail\"><a class=\"ds-rail-link\" aria-current=\"page\" href=\"#\"><span class=\"ds-rail-mark\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#8a5a0c\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3\"/><path d=\"M12 9v4\"/><path d=\"M12 17h.01\"/></svg></span>Checkout v3</a><a class=\"ds-rail-link\" href=\"#\"><span class=\"ds-rail-mark\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#b3311f\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M2.586 16.726A2 2 0 0 1 2 15.312V8.688a2 2 0 0 1 .586-1.414l4.688-4.688A2 2 0 0 1 8.688 2h6.624a2 2 0 0 1 1.414.586l4.688 4.688A2 2 0 0 1 22 8.688v6.624a2 2 0 0 1-.586 1.414l-4.688 4.688a2 2 0 0 1-1.414.586H8.688a2 2 0 0 1-1.414-.586z\"/><path d=\"m15 9-6 6\"/><path d=\"m9 9 6 6\"/></svg></span>Payments migration</a></nav>",
      "css": ".ds-rail{display:grid;gap:2px;width:232px;padding:12px;background:var(--rail)}.ds-rail-link{display:flex;align-items:center;gap:8px;padding:6px 12px;border-radius:4px;color:var(--rail-muted);font:400 13px/20px var(--font-geist-sans),sans-serif;text-decoration:none;transition:background .15s,color .15s}.ds-rail-link:hover,.ds-rail-link[aria-current=page]{background:var(--rail-raised);color:var(--rail-foreground)}.ds-rail-link:focus-visible{outline:2px solid var(--pencil);outline-offset:2px}.ds-rail-mark{display:flex;width:16px;height:16px;align-items:center;justify-content:center;border-radius:3px;background:var(--sheet)}.ds-rail-mark svg{width:12px;height:12px}"
    },
    {
      "name": "Tickmark Legend",
      "kind": "custom",
      "description": "Authored blue-pencil tickmarks keyed to a printed legend; dotted circle means no evidence.",
      "html": "<div class=\"ds-legend\"><b>Tickmarks</b><span><svg viewBox=\"0 0 20 20\"><path d=\"M2.6 10.8c1.3.9 2.5 2.2 3.6 4 2.6-4.6 6.2-8.6 11.3-12.1\"/></svg>Agreed to source data</span><span><svg viewBox=\"0 0 20 20\"><path d=\"M2.4 9.6c1.2.8 2.3 2 3.3 3.6 2.3-4 5.4-7.4 9.6-10.4\"/><path d=\"M16.9 14.9c0 1.6-1.1 2.8-2.5 2.8s-2.4-1.1-2.4-2.6c0-1.6 1.2-2.8 2.6-2.8 1.3 0 2.3 1.1 2.3 2.4\"/></svg>Traced to document</span><span><svg viewBox=\"0 0 20 20\"><path d=\"M2.6 8.6c1.2.8 2.3 2 3.3 3.6 2.3-4 5.4-7.4 9.6-10.4\"/><path d=\"M2.4 16.6c4.6-.6 9.6-.9 15.2-.4\"/></svg>Signed off</span><span class=\"ds-none\"><svg viewBox=\"0 0 20 20\"><path d=\"M10 4.6c3.2 0 5.5 2.4 5.5 5.4s-2.4 5.5-5.6 5.5c-3.1 0-5.4-2.5-5.4-5.4 0-3.1 2.4-5.4 5.3-5.3\" stroke-dasharray=\"1.4 1\"/></svg>No evidence</span></div>",
      "css": ".ds-legend{display:flex;flex-wrap:wrap;gap:8px 24px;font:400 12px/16px var(--font-geist-sans),sans-serif;color:var(--muted-foreground)}.ds-legend b{font-weight:500;color:var(--foreground)}.ds-legend span{display:inline-flex;align-items:center;gap:6px}.ds-legend svg{width:14px;height:14px;fill:none;stroke:var(--pencil);stroke-width:2.3;stroke-linecap:round;stroke-linejoin:round}.ds-legend .ds-none svg{stroke:var(--unknown)}"
    },
    {
      "name": "Gate Result Mark",
      "kind": "chip",
      "description": "Result word led by an 8px square; filled for Pass/Fail, outlined for Unknown. Never a checkmark.",
      "html": "<div class=\"ds-marks\"><span class=\"ds-mark ds-pass\"><i></i>Pass</span><span class=\"ds-mark ds-fail\"><i></i>Fail</span><span class=\"ds-mark ds-unknown\"><i></i>Unknown</span></div>",
      "css": ".ds-marks{display:flex;gap:20px}.ds-mark{display:inline-flex;align-items:center;gap:6px;font:600 13px/20px var(--font-geist-sans),sans-serif}.ds-mark i{width:8px;height:8px;border-radius:1px}.ds-pass{color:var(--go)}.ds-pass i{background:var(--go)}.ds-fail{color:var(--nogo)}.ds-fail i{background:var(--nogo)}.ds-unknown{color:var(--unknown)}.ds-unknown i{border:1px solid currentColor}"
