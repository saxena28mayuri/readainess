      "css": ".ds-memo{font:400 14px/24px var(--font-geist-sans),sans-serif;color:var(--foreground)}.ds-cite{display:inline-flex;align-items:center;height:18px;margin:0 2px;padding:0 4px;border:0;border-radius:3px;background:var(--pencil-soft);color:var(--pencil);font:500 11px var(--font-geist-mono),monospace;cursor:pointer;vertical-align:1px}.ds-cite:hover{background:var(--pencil);color:#fff}.ds-cite:focus-visible{outline:2px solid var(--pencil);outline-offset:2px}"
    }
  ],
  "narrative": {
    "northStar": "The Audit Working Paper",
    "overview": "Readiness is reviewed the way an auditor signs off. The recommendation reads as an opinion (Go, Conditional, No-Go), every figure is tickmarked back to its source in blue pencil, and every superseded call stays on file, struck through rather than erased. The working paper sits in a deep green binder rail on a cool green-grey ground; the sheets are white with hairline rules.\n\nDensity is high and calm: a dense gate table is the centre of gravity, set in a sans for reading and a tabular mono for anything a reviewer might tick against a source. Colour is scarce by rule. Green is the binder and the primary action, blue is the auditor's hand, and red, amber and green-for-Go appear only where they carry a verdict. The system is light only: it is used in readiness reviews on shared screens under office light.",
    "keyCharacteristics": [
      "Green rail and primary action; cool green-grey ground; white sheets with 1px hairline rules.",
      "Blue-pencil tickmarks as authored SVG strokes, always keyed to a printed legend.",
      "Verdict colours reserved for Go / Conditional / No-Go / Unknown, each with a soft tint.",
      "Geist Sans for language, Geist Mono with tabular numerals for data, figures and gate IDs.",
      "Superseded checks, recommendations and overridden calls stay visible, struck through.",
      "One signature motion: tickmarks strike down the evidence column when a new check lands."
    ],
    "rules": [
      {
        "name": "The Verdict-Only Rule",
        "body": "Go, Conditional, No-Go and Unknown colours appear only where they carry a verdict or state outcome. Never use them for decoration, category or emphasis.",
        "section": "colors"
      },
      {
        "name": "The One Hand Rule",
        "body": "Pencil blue is the auditor's hand: tickmarks, gate IDs, citations, links, focus. It is never a fill for buttons or panels.",
        "section": "colors"
      },
      {
        "name": "The Ledger Rule",
        "body": "Mono is for data only: figures, counts, gate IDs, evidence lines, rules, model names and keys. Sentences, labels and headings are always sans. Every number a reviewer compares uses tabular numerals.",
        "section": "typography"
      },
      {
        "name": "The Paper-On-Desk Rule",
        "body": "Sheets are separated from the ground by tone and border. No floating cards, no hover lifts, no layered shadows.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do key every verified figure to a blue-pencil tickmark and keep the legend on screen beneath the table.",
      "Do strike through superseded checks, recommendations and overridden calls in unknown slate; never remove them.",
      "Do set every comparable figure in Geist Mono with tabular numerals.",
      "Do keep the gate table's six furniture columns fixed across releases, and keep history at one scale.",
      "Do always state a verdict as a word; colour and icon only support it."
    ],
    "donts": [
      "Don't use Go, Conditional, No-Go or Unknown colours outside a verdict or state outcome.",
      "Don't draw checkmarks for gate results; the result mark is a square.",
      "Don't fill buttons or panels with pencil blue.",
      "Don't add a dark theme; the paper is light only for shared screens under office light.",
