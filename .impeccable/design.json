    {
      "name": "Opinion Block",
      "kind": "card",
      "refersTo": "sheet",
      "description": "The recommendation as an opinion: verdict word at display size, one-sentence rationale, ruled mono figures, 3px verdict top rule.",
      "html": "<section class=\"ds-opinion\"><div><p class=\"ds-rec\">No-Go</p><p class=\"ds-why\">2 blocking gates failed and 1 more is waiting on evidence.</p></div><dl><div><dt>Gates passing</dt><dd>5 of 9</dd></div><div><dt>Blocking exceptions</dt><dd>3</dd></div><div><dt>Advisory exceptions</dt><dd>1</dd></div></dl></section>",
      "css": ".ds-opinion{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:16px 32px;padding:16px 20px;background:var(--sheet);border:1px solid var(--border);border-top:3px solid var(--nogo);border-radius:4px;font-family:var(--font-geist-sans),sans-serif;color:var(--foreground)}.ds-rec{margin:0;font-size:30px;line-height:1;font-weight:600;letter-spacing:-.025em;color:var(--nogo)}.ds-why{margin:12px 0 0;max-width:60ch;font-size:15px;line-height:24px}.ds-opinion dl{margin:0;min-width:224px;font-size:14px}.ds-opinion dl div{display:flex;justify-content:space-between;gap:24px;padding:6px 0;border-bottom:1px solid var(--rule)}.ds-opinion dl div:last-child{border:0}.ds-opinion dt{color:var(--muted-foreground)}.ds-opinion dd{margin:0;font:500 14px var(--font-geist-mono),monospace;font-variant-numeric:tabular-nums}"
    },
    {
      "name": "History Strip",
      "kind": "custom",
      "refersTo": "history-cell",
      "description": "Checks side by side at one fixed scale; superseded columns fade and their verdict is struck.",
      "html": "<ol class=\"ds-history\"><li><div><i class=\"f\"></i><i class=\"f\"></i><i class=\"u\"></i><i class=\"p\"></i></div><s>No-Go</s><small>2d ago</small></li><li class=\"latest\"><div><i class=\"p\"></i><i class=\"f\"></i><i class=\"p\"></i><i class=\"p\"></i></div><b>No-Go</b><small>1h ago</small></li></ol>",
      "css": ".ds-history{display:flex;align-items:flex-end;gap:12px;margin:0;padding:12px 16px;list-style:none;background:var(--sheet);border:1px solid var(--border);border-radius:6px;font:600 11px var(--font-geist-sans),sans-serif}.ds-history li{display:flex;flex-direction:column;align-items:center;gap:6px;padding:4px 6px;border-radius:4px}.ds-history li.latest{background:var(--muted)}.ds-history div{display:flex;flex-direction:column;gap:3px;opacity:.45}.ds-history .latest div{opacity:1}.ds-history i{display:block;width:24px;height:8px;border-radius:1px}.ds-history .p{background:var(--go)}.ds-history .f{background:var(--nogo)}.ds-history .u{background:#b6c2bc}.ds-history s{color:var(--unknown)}.ds-history b{color:var(--nogo)}.ds-history small{font-weight:400;color:var(--muted-foreground);font-variant-numeric:tabular-nums}"
    },
